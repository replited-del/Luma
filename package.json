{
  "name": "luma-music",
  "version": "1.6.1",
  "description": "Luma local music player with Spotify link downloads and optional service players for Windows",
  "author": "Luma",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node tests/smoke.cjs && node tests/features.cjs && node tests/listening.cjs && node tests/services.cjs && node tests/spotify.cjs",
    "build": "electron-builder --win portable --x64 --publish never"
  },
  "dependencies": {
    "music-metadata": "12.2.3",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "electron": "44.10.0",
    "electron-builder": "26.18.0",
    "playwright": "1.64.1"
  },
  "build": {
    "appId": "local.luma.music",
    "productName": "Luma",
    "directories": {
      "output": "../Luma-build"
    },
    "files": [
      "main.cjs",
      "library-backup.cjs",
      "service-import.cjs",
      "spotdl-download.cjs",
      "THIRD_PARTY.md",
      "preload.cjs",
      "ui/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signExecutable": false,
      "icon": "ui/icon.png"
    },
    "portable": {
      "artifactName": "Luma-${version}-Windows.exe"
    }
  }
}
